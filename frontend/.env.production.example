# SourceSignal — Vercel production environment
#
# Copy this file to .env.local on Vercel and replace every placeholder.
# Generate secrets with: openssl rand -hex 32
#
# On the VPS, copy to .env and ensure Caddy is running for TLS.
#
# DATABASE_URL must point to your managed Postgres provider (Neon / Supabase / RDS).
# All other secrets are optional — the app degrades gracefully when absent.

# ---------------------------------------------------------------------------
# PostgreSQL (managed provider)
# ---------------------------------------------------------------------------
# Neon:   postgres://user:pass@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require
# Supabase: postgres://user:pass@db.xxx.supabase.co:5432/postgres?sslmode=require
# Local dev:  postgres://postgres:secretpassword@localhost:5432/sourcesignal_db?sslmode=disable
#
DATABASE_URL=postgres://sourcesignal:replace-with-openssl-rand-hex-32@ep-xxx.us-east-1.aws.neon.tech/sourcesignal_db?sslmode=require

# Optional: dedicated direct-connection string (bypasses PgBouncer pooler)
# for admin scripts / migrations. Leave unset to fall back to DATABASE_URL.
# DIRECT_DATABASE_URL=postgres://sourcesignal:replace-with-openssl-rand-hex-32@ep-xxx.us-east-1.aws.neon.tech/sourcesignal_db?sslmode=require

# Enable SSL when your provider requires it (Neon/Supabase do).
DATABASE_SSL=true

# ---------------------------------------------------------------------------
# Redis (optional — cache/session fallback to PostgreSQL is built in)
# ---------------------------------------------------------------------------
# Upstash: redis://:password@redis.us-east-1.upstash.cloud:6379
# Local/unused: leave unset; the cache layer falls back to PostgreSQL or memory.
REDIS_URL=redis://:replace-with-openssl-rand-hex-32@redis:6379

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Production (Vercel): https://sourcesignal.site
# On the VPS leave unset so API routes are served locally.
NEXT_PUBLIC_APP_URL=https://sourcesignal.site
APP_ORIGIN=https://sourcesignal.site

# JWT_SECRET — session token signing secret. Required in production.
JWT_SECRET=replace-with-openssl-rand-hex-32

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_ID_PRO=price_replace_me
STRIPE_PRICE_ID_PRO_GBP=price_replace_me
STRIPE_PRICE_ID_PRO_USD=price_replace_me
STRIPE_PRICE_ID_PRO_EUR=price_replace_me
STRIPE_PRICE_ID_PRO_AUD=price_replace_me

# ---------------------------------------------------------------------------
# NVIDIA AI extraction
# ---------------------------------------------------------------------------
NVIDIA_API_KEY=nvapi-replace_me
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=replace_me

# ---------------------------------------------------------------------------
# Outbound webhooks
# ---------------------------------------------------------------------------
WEBHOOK_SIGNING_SECRET=replace-with-openssl-rand-hex-32

# ---------------------------------------------------------------------------
# Ingestion worker (optional; only used with the "ingestion" profile)
# ---------------------------------------------------------------------------
# The worker still targets PostgreSQL. Set these if you enable the ingestion profile.
# POCKETBASE_ADMIN_EMAIL=admin@example.com
# POCKETBASE_ADMIN_PASSWORD=replace-me
# NEXT_PUBLIC_POCKETBASE_URL=http://pocketbase:8090