# SourceSignal — local development environment
# Copy this file to .env and fill in values for local development.
# Never commit real credentials. All .env* files are gitignored.

# PostgreSQL connection string.
# Local:  postgres://postgres:secretpassword@localhost:5432/sourcesignal_db?sslmode=disable
# Neon:   postgres://user:pass@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require
# Supabase: postgres://user:pass@db.xxx.supabase.co:5432/postgres?sslmode=require
DATABASE_URL="postgres://postgres:secretpassword@localhost:5432/sourcesignal_db?sslmode=disable"

# Public URL users visit (used for Stripe redirects, email links, SEO).
# Production (Vercel): https://sourcesignal.site
# Leave unset on local dev.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Browser origin allowed to call the API directly (CSRF + CORS allow-list).
# Production: https://sourcesignal.site
# Leave unset on local dev.
APP_ORIGIN="http://localhost:3000"

# Backend API origin for server-to-server calls from the frontend.
# Production (Vercel): https://api.sourcesignal.site
# Leave unset on local dev.
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Session token signing secret. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production

# Webhook signing secret for outbound webhook dispatch (Phase F)
WEBHOOK_SIGNING_SECRET=change-me-in-production

# Stripe price IDs for the Pro plan by currency (server only).
# At least one must be configured; the first available is used as fallback.
STRIPE_PRICE_ID_PRO_GBP=change-me-in-production
STRIPE_PRICE_ID_PRO_USD=change-me-in-production
STRIPE_PRICE_ID_PRO_EUR=change-me-in-production
STRIPE_PRICE_ID_PRO_AUD=change-me-in-production
STRIPE_PRICE_ID_PRO=change-me-in-production

# Primary-source ingestion — key-authenticated adapters (optional).
# Free adapters run without keys; keyed adapters self-disable when unset.
COMPANIES_HOUSE_API_KEY=
SAM_GOV_API_KEY=
TED_EU_API_KEY=

# SEC EDGAR requires a descriptive User-Agent, ideally including contact info.
SEC_EDGAR_USER_AGENT="SourceSignal/1.0 (ops@sourcesignal.site)"
# Optional comma-separated CIK watchlist. Defaults to major federal contractors.
# SEC_EDGAR_CIKS="0000936468,0000101829,0000012927"

# User-Agent used for free public feeds (GOV.UK, Planning Data, USAspending...).
INGESTION_USER_AGENT="SourceSignal/1.0 (+https://sourcesignal.site)"

# Redis connection URL (cache, sessions, rate-limit counters).
# Optional: when unset or unreachable, the cache layer falls back to
# PostgreSQL cache_entries and then in-process memory.
REDIS_URL="redis://localhost:6379"