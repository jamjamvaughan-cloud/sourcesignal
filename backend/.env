# SourceSignal Backend Environment Configuration
# DO NOT commit this file to version control.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3001
API_URL=https://api.sourcesignal.site
LOG_LEVEL=info
ALLOWED_ORIGINS=https://sourcesignal.site

# ---------------------------------------------------------------------------
# Domain / Traefik / Let's Encrypt
# ---------------------------------------------------------------------------
DOMAIN=sourcesignal.site
ACME_EMAIL=admin@sourcesignal.site
TRAEFIK_AUTH_USERS=admin:REPLACE_WITH_BCRYPT_HASH

# ---------------------------------------------------------------------------
# PostgreSQL (via PgBouncer in transaction mode)
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=5ab4fd965705e04f1835a2e292f3665c672cf0fcc08104c909c61f67ff51b91b
POSTGRES_DB=sourcesignal
DATABASE_URL=postgresql://postgres:5ab4fd965705e04f1835a2e292f3665c672cf0fcc08104c909c61f67ff51b91b@pgbouncer:5432/sourcesignal

# ---------------------------------------------------------------------------
# Redis (sessions, rate limiting, BullMQ job queues)
# ---------------------------------------------------------------------------
REDIS_PASSWORD=162700d1134f7cf2e23b0e08510c5ffe0e7ec51bb6630e705527e3b7deebcfce
REDIS_URL=redis://:162700d1134f7cf2e23b0e08510c5ffe0e7ec51bb6630e705527e3b7deebcfce@redis:6379

# ---------------------------------------------------------------------------
# JWT (auth tokens)
# ---------------------------------------------------------------------------
JWT_SECRET=f30d0551e20b16cd9693e8824714c68181a105143a255b9d796a55f7a4cc6c04
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# PgBouncer tuning
# ---------------------------------------------------------------------------
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=2000
PGBOUNCER_DEFAULT_POOL_SIZE=100
PGBOUNCER_RESERVE_POOL_SIZE=20
PGBOUNCER_MAX_DB_CONNECTIONS=500
PGBOUNCER_MAX_USER_CONNECTIONS=200

# ---------------------------------------------------------------------------
# BullMQ
# ---------------------------------------------------------------------------
BULLMQ_PREFIX=sourcesignal

# ---------------------------------------------------------------------------
# SSL / Database
# ---------------------------------------------------------------------------
DATABASE_SSL=false
