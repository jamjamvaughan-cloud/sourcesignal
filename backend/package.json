{
  "name": "sourcesignal-backend",
  "version": "1.0.0",
  "private": true,
  "description": "SourceSignal competitive intelligence & pre-RFP tracking backend API",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "dev": "tsx watch src/index.ts",
    "worker": "tsx src/workers/background.worker.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "psql \"$DATABASE_URL\" -f migrations/001_initial_schema.sql"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.15.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
