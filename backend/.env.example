# SourceSignal Backend Environment Configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in all required values before starting.
# Never commit `.env` to version control. Generate secrets with:
#   openssl rand -hex 32
# ---------------------------------------------------------------------------

# ===========================================================================
# Application
# ===========================================================================
NODE_ENV=production
PORT=3001
# Public URL of the API (used by webhooks, emails, CORS)
API_URL=https://api.sourcesignal.site
LOG_LEVEL=info
# Comma-separated list of allowed CORS origins (e.g. https://sourcesignal.site,https://app.sourcesignal.site)
ALLOWED_ORIGINS=https://sourcesignal.site

# ===========================================================================
# Domain / Traefik / Let's Encrypt
# ===========================================================================
# The domain Traefik will secure with automatic Let's Encrypt certificates.
DOMAIN=sourcesignal.site
# Email for Let's Encrypt account / expiry notifications (REQUIRED).
ACME_EMAIL=admin@sourcesignal.site
# Traefik dashboard basic-auth username:hashedpassword
# Generate with: htpasswd -nb admin <password>  (copy the whole "admin:$2y$..." line)
TRAEFIK_AUTH_USERS=admin:REPLACE_WITH_BCRYPT_HASH

# ===========================================================================
# PostgreSQL (via PgBouncer in transaction mode)
# ===========================================================================
POSTGRES_USER=postgres
POSTGRES_DB=sourcesignal
# Strong password for the postgres user (used by PgBouncer & direct admin access).
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# Connection string used by the API & worker (goes through PgBouncer).
DATABASE_URL=postgresql://postgres:REPLACE_WITH_STRONG_PASSWORD@pgbouncer:5432/sourcesignal

# ===========================================================================
# Redis (sessions, rate limiting, BullMQ job queues)
# ===========================================================================
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD@redis:6379

# ===========================================================================
# JWT (auth tokens)
# ===========================================================================
# Signing secret for access/session JWTs — MUST be long and random (min 32 chars).
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_JWT_SECRET
JWT_EXPIRES_IN=7d

# ===========================================================================
# PgBouncer tuning
# ===========================================================================
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=2000
PGBOUNCER_DEFAULT_POOL_SIZE=100
PGBOUNCER_RESERVE_POOL_SIZE=20
PGBOUNCER_MAX_DB_CONNECTIONS=500
PGBOUNCER_MAX_USER_CONNECTIONS=200

# ===========================================================================
# BullMQ
# ===========================================================================
BULLMQ_PREFIX=sourcesignal

# ===========================================================================
# SSL / Database
# ===========================================================================
# Set to "true" only if connecting to a managed Postgres that requires SSL.
DATABASE_SSL=false
