# SourceSignal — VPS production environment
#
# Copy this file to .env on the VPS and replace every placeholder.
# Generate secrets with: openssl rand -hex 32
#
# Do NOT set BACKEND_URL here. On the VPS the API routes are served locally;
# BACKEND_URL is only set on the Vercel frontend deployment.

# ---------------------------------------------------------------------------
# PostgreSQL / PgBouncer
# ---------------------------------------------------------------------------
POSTGRES_USER=sourcesignal
POSTGRES_PASSWORD=0145f18a70862cc624f496242de1f2ae0afccc4010deedc0067c223ce06296f6
POSTGRES_DB=sourcesignal_db
DATABASE_URL=postgres://sourcesignal:0145f18a70862cc624f496242de1f2ae0afccc4010deedc0067c223ce06296f6@pgbouncer:6432/sourcesignal_db?sslmode=disable
# Must match POSTGRES_* above. Use a hex password so it needs no URL encoding.
DATABASE_URL=postgres://sourcesignal:0145f18a70862cc624f496242de1f2ae0afccc4010deedc0067c223ce06296f6@pgbouncer:6432/sourcesignal_db?sslmode=disable
# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PASSWORD=5bff90015faf8e50c047227d0fe4069900ce3f62ade964e8af2c411b7262d8dc
REDIS_URL=redis://:5bff90015faf8e50c047227d0fe4069900ce3f62ade964e8af2c411b7262d8dc@redis:6379

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
JWT_SECRET=d319c5678d7b99c206a36eb4bff19883ffe4b6ad2f07c8c1877ad8165b44c44e
NEXT_PUBLIC_APP_URL=https://sourcesignal.site
APP_ORIGIN=https://sourcesignal.site

# Backend API origin for server-to-server calls from the frontend.
# Set this ONLY on the Vercel frontend deployment; leave it unset on the VPS
# so API routes are served locally.
# NEXT_PUBLIC_API_URL=https://api.sourcesignal.site

SERVICE_NAME=sourcesignal-api

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_ID_PRO=price_replace_me
STRIPE_PRICE_ID_PRO_GBP=price_replace_me
STRIPE_PRICE_ID_PRO_USD=price_replace_me
STRIPE_PRICE_ID_PRO_EUR=price_replace_me
STRIPE_PRICE_ID_PRO_AUD=price_replace_me

# ---------------------------------------------------------------------------
# NVIDIA AI extraction
# ---------------------------------------------------------------------------
NVIDIA_API_KEY=nvapi-replace_me
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=replace_me

# ---------------------------------------------------------------------------
# Outbound webhooks
# ---------------------------------------------------------------------------
WEBHOOK_SIGNING_SECRET=1b1278dbca48c86895a1796f2e9b3f0c28bfcc86bb695caa3749c8e4eb9ebd19

# ---------------------------------------------------------------------------
# Ingestion worker (optional; only used with the "ingestion" profile)
# The worker still targets PocketBase until it is migrated to PostgreSQL.
# ---------------------------------------------------------------------------
# POCKETBASE_ADMIN_EMAIL=admin@example.com
# POCKETBASE_ADMIN_PASSWORD=replace-me
# NEXT_PUBLIC_POCKETBASE_URL=http://pocketbase:8090
